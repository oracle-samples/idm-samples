# =============================================================================
# Generic application settings
# =============================================================================
# WEB_PORT must match the port registered in OIDC_REDIRECT_URI.
WEB_PORT=8080
BRIDGE_PORT=7071
# Optional override; if set, its port must match BRIDGE_PORT.
# BRIDGE_URL=http://127.0.0.1:7071
# Maximum time for a request from the Node.js app to the local bridge.
BRIDGE_REQUEST_TIMEOUT_MS=30000

# =============================================================================
# IAM authentication and biometric API configuration
# =============================================================================
# Use false only after configuring the required OIDC, mTLS, and IAM endpoint values below.
IAM_MOCK_MODE=true
# Maximum time for enrollment, verification, and factor-management IAM API requests.
IAM_REQUEST_TIMEOUT_MS=30000

# Browser-user login: IAM confidential application with Authorization Code grant.
# Do not commit secrets or private keys.
# OIDC_ISSUER=https://idcs-<guid>.identity.oraclecloud.com
# OIDC_CLIENT_ID=<browser-client-id>
# OIDC_CLIENT_SECRET=<browser-client-secret>
OIDC_REDIRECT_URI=http://127.0.0.1:8080/oauth/callback
OIDC_SCOPES="openid profile email"

# Separate IAM confidential application with TLS Client Authentication grant.
# Do not commit secrets or private keys.
# IAM_TOKEN_URL must be an IAM mTLS URL.
# IAM_TOKEN_URL=https://idcs-<guid>.secure.identity.oraclecloud.com/oauth2/v1/token
# OAuth scope requested for the service token.
IAM_SERVICE_SCOPE=urn:opc:idm:biometrics
# IAM_CLIENT_ID=<service-client-id>
# IAM_CLIENT_CERT and IAM_CLIENT_KEY must be PEM encoded.
# IAM_CLIENT_CERT=/absolute/path/client.crt
# IAM_CLIENT_KEY=/absolute/path/client.key
# Logs redacted IAM request/response structures. Authorization, credentials, request state,
# seed values, and biometric material remain redacted.
IAM_DEBUG_LOGGING=false

# Base URL for standard MFA enrollment, verification, factor listing, and deletion.
# It must use the IAM mTLS hostname and end in /mfa/v1. The app derives the
# user-factor and verification POST/PATCH URLs; do not configure /secure/requests.
# IAM_MFA_BASE_URL=https://idcs-<guid>.secure.identity.oraclecloud.com/mfa/v1
# BTP client metadata expected by IAM.
IAM_BTP_CLIENT_VERSION=1.0.0
# Test-only fixed template used for both enrollment and verification. Keep the
# actual value only in the ignored .env file; never commit biometric material.
# IAM_BIOMETRIC_DATA_OVERRIDE=

# =============================================================================
# Fingerprint reader integration
# =============================================================================
# Use "lumidigm" for the Lumidigm vCOM implementation.
FINGERPRINT_READER=mock
# VCOM_JAVA_API_DIR=C:\path\to\VCOM_Integration_Kit_v9.6.41389\SampleCode\GUI_Apps\Java\JNI\VCOMExampleJavaAPI
# VCOM_LIBRARY_DIR=C:\path\to\VCOM_Integration_Kit_v9.6.41389\bin

# Development-only metadata for the bundled mock reader.
FINGERPRINT_DEVICE_MAPPING_1=mock -> model=Reference mock reader;version=1.0;padLevel=TEST_ONLY
# Lumidigm vCOM reports vendorId=8110;productId=1312 for the Lumidigm V52X reader family.
# For a physical reader, use its V100GetConfig deviceSerial value and replace every placeholder:
# FINGERPRINT_DEVICE_MAPPING_2=vendorId=8110;productId=1312;serial=<device-serial> -> model=<approved-model>;version=<approved-version>;padLevel=<certified-pad-level>
# For example:
# FINGERPRINT_DEVICE_MAPPING_3=vendorId=8110;productId=1312;serial=36918 -> model=HID Lumidigm V521-01-01;version=V521;padLevel=L1
# You are responsible for ensuring each mapping identifies the actual reader being used
# and supplies the model, version, and padLevel values expected by IAM. padLevel must correspond
# to the "ISO/IEC 30107-3 PAD Level" certification of that device.

# =============================================================================
# Tech5 BTP
# =============================================================================
# Use "tech5" for the Tech5 BTP implementation.
FINGERPRINT_TEMPLATE_EXTRACTOR=mock
# Tech5 BTP protects captures from any configured reader. TECH5_SDK_DIR directly contains
# Tech5OmniMatchJavaWrapper-6.10.0.jar and the native libraries.
# TECH5_BTP_SEED1=<deployment-secret-positive-integer>
# TECH5_SDK_DIR=C:\path\to\Tech5\sdk
# TECH5_BTP_DIR=C:\path\to\Tech5\btp
# The license file must reside directly in TECH5_BTP_DIR.
# TECH5_LICENSE_FILE=C:\path\to\Tech5\btp\t5omnimatchsdk.lic
