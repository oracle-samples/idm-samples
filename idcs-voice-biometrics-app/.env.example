# AI World local configuration.
# Copy to `.env` and fill only references/identifiers. `.env` is ignored by Git.
# Never paste a session token, private key, passphrase, client secret, password, or certificate.

# The app validates the exact browser Origin against this URL. Use trusted HTTPS for remote
# microphone access. This template does not select or enforce a separate transport profile.
# Address on which Java listens; use 0.0.0.0 inside a container behind a trusted TLS ingress.
AI_WORLD_BIND_ADDRESS=127.0.0.1
# Exact browser-facing origin, including scheme and nondefault port.
AI_WORLD_PUBLIC_ORIGIN=https://localhost:8443
# Port on which Java listens; match the embedded HTTPS listener or ingress upstream.
AI_WORLD_BACKEND_PORT=8443
# Enable Java HTTPS only when the two PEM files below are supplied; otherwise terminate TLS at ingress.
AI_WORLD_TLS_ENABLED=false
# PEM certificate chain for the browser-facing Java HTTPS listener, if enabled.
AI_WORLD_TLS_CERTIFICATE_FILE=
# Customer-owned PEM private key for Java HTTPS, if enabled; keep it out of source and images.
AI_WORLD_TLS_PRIVATE_KEY_FILE=

# Doctor sign-in through an OCI IAM identity domain (formerly IDCS). Keep disabled until every
# required value is filled and the tenant's trusted application has the Resource Owner grant.
# Java, never the browser, calls <domain>/oauth2/v1/token with grant_type=password.
AI_WORLD_IDCS_ENABLED=false
# Identity validation: STRICT_JWT for release validation; DEMO_PROFILE for an isolated local demo.
AI_WORLD_IDCS_AUTHENTICATION_MODE=STRICT_JWT
# HTTPS origin of the customer identity domain used for user sign-in.
AI_WORLD_IDCS_DOMAIN_URL=
# Password-grant token path relative to the identity-domain origin.
AI_WORLD_IDCS_TOKEN_PATH=/oauth2/v1/token
# Fixed identity-profile path used only by DEMO_PROFILE after a successful grant.
AI_WORLD_IDCS_PROFILE_PATH=/admin/v1/Me
# OAuth client ID of the customer application used for user sign-in.
AI_WORLD_IDCS_CLIENT_ID=

# The referenced file contains only the confidential-client secret. Restrict it to the Java
# process account; do not put the secret itself in this file.
AI_WORLD_IDCS_CLIENT_SECRET_FILE=

# STRICT_JWT is the default and release-capable identity-validation mode. It requires the exact
# issuer, audience, JWKS URI, domain, and claim mapping approved for the client.
# For a local progress demo only, set AI_WORLD_IDCS_AUTHENTICATION_MODE=DEMO_PROFILE. That mode
# performs the same password grant and then calls the fixed HTTPS /admin/v1/Me resource; it requires
# the client application's Me role but does not use the STRICT_JWT-only values below. DEMO_PROFILE
# OAuth scope granted to the customer sign-in application; confirm with its IAM administrator.
AI_WORLD_IDCS_SCOPE=
# Keep true normally. Set false only with DEMO_PROFILE for an isolated local demo whose internal
# IDCS certificate chain is not installed locally; false disables IDCS certificate validation.
AI_WORLD_IDCS_TLS_VERIFY=true
# Exact expected JWT issuer approved for this identity domain.
AI_WORLD_IDCS_ISSUER=
# Expected JWT audience for the customer sign-in application.
AI_WORLD_IDCS_AUDIENCE=
# Trusted HTTPS JWKS URL used to verify identity-token signatures.
AI_WORLD_IDCS_JWKS_URI=
# Exact claim/value pair approved for this identity domain. Issuer validation remains separate.
AI_WORLD_IDCS_IDENTITY_DOMAIN_CLAIM=
# Expected value of the configured identity-domain claim.
AI_WORLD_IDCS_IDENTITY_DOMAIN_VALUE=
# JWT claim containing the validated username.
AI_WORLD_IDCS_USERNAME_CLAIM=
# JWT claim containing the display name.
AI_WORLD_IDCS_DISPLAY_NAME_CLAIM=
# JWT claim containing the organization shown for the signed-in user.
AI_WORLD_IDCS_ORGANIZATION_CLAIM=
# JWT claim containing the IAM user GUID used for voice-factor operations.
AI_WORLD_IDCS_USER_GUID_CLAIM=

# Maximum time in milliseconds to establish an IDCS connection.
AI_WORLD_IDCS_CONNECT_TIMEOUT_MS=3000
# Maximum wait in milliseconds for an IDCS response.
AI_WORLD_IDCS_RESPONSE_TIMEOUT_MS=10000
# Allowed identity-token clock skew in seconds.
AI_WORLD_IDCS_CLOCK_SKEW_SECONDS=60
# Maximum login attempts per username during the configured rate-limit window.
AI_WORLD_IDCS_LOGIN_RATE_LIMIT_ATTEMPTS=10
# Maximum login attempts per client IP during the same rate-limit window.
AI_WORLD_IDCS_LOGIN_RATE_LIMIT_IP_ATTEMPTS=100
# Login rate-limit window in seconds.
AI_WORLD_IDCS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Application-session idle timeout in seconds.
AI_WORLD_SESSION_IDLE_SECONDS=900
# Maximum application-session lifetime in seconds, regardless of activity.
AI_WORLD_SESSION_ABSOLUTE_SECONDS=28800
# Maximum number of active in-memory application sessions.
AI_WORLD_SESSION_CAPACITY=1000

# STRICT_JWT-only approved validated doctor identities, one per line. This is an authorization
# input, not a source of display identity; username/display values still come only from the
# validated IDCS token. DEMO_PROFILE intentionally does not use this file: any IDCS user who
# completes the password grant and whose /admin/v1/Me userName matches the submitted username may
# create an application session.
AI_WORLD_IDCS_APPROVED_DOCTORS_FILE=

# IAM Voice factor-status lookup. This uses a distinct mTLS-bound service token and the same
# certificate on the secure-MFA request. Keep disabled until the complete factor response schema
# and ENROLLED predicate are reviewed; the UI will show a safe status-unavailable state meanwhile.
AI_WORLD_IAM_STATUS_ENABLED=false
# Enable the consent and enrollment journey for customer-authorized test accounts.
AI_WORLD_IAM_ENROLLMENT_ENABLED=false
# HTTPS secure identity-domain origin for mTLS-protected IAM voice APIs.
AI_WORLD_IAM_SECURE_DOMAIN_URL=
# Client-credentials token path relative to the secure IAM origin.
AI_WORLD_IAM_SERVICE_TOKEN_PATH=/oauth2/v1/token
# OAuth client ID permitted to call IAM Voice APIs with the configured client certificate.
AI_WORLD_IAM_SERVICE_CLIENT_ID=
# Scopes granted to the IAM Voice service OAuth application.
AI_WORLD_IAM_SERVICE_SCOPE=urn:opc:idm:__myscopes__
# Keep true outside an explicitly approved local demo. false disables server-certificate validation
# only to work around a known internal secure-domain certificate mismatch.
AI_WORLD_IAM_TLS_VERIFY=true
# IAM factor-list path; Java substitutes the signed-in userId.
AI_WORLD_IAM_FACTOR_STATUS_PATH=/mfa/v1/users/{userId}/factors
# IAM voice verification request collection path.
AI_WORLD_IAM_VERIFICATION_REQUEST_PATH=/mfa/v1/requests
# IAM verification request path used for completion; Java substitutes requestId.
AI_WORLD_IAM_VERIFICATION_REQUEST_ITEM_PATH=/mfa/v1/requests/{requestId}
# Maximum time in milliseconds to establish an IAM connection.
AI_WORLD_IAM_CONNECT_TIMEOUT_MS=3000
# Maximum wait in milliseconds for an IAM response.
AI_WORLD_IAM_RESPONSE_TIMEOUT_MS=10000

# Oracle's factor-list contract returns enrolled factors in /factors and each factor's methods array.
# Presence of VOICE_BIOMETRIC means enrolled; AUTH-1131/noFactorFound or absence means not enrolled.
AI_WORLD_IAM_FACTOR_MAPPING_APPROVED=false
# JSON Pointer identifying the factor list in the approved IAM response schema.
AI_WORLD_IAM_FACTORS_JSON_POINTER=/factors
# Field containing supported authentication methods on each IAM factor.
AI_WORLD_IAM_FACTOR_METHOD_FIELD=methods
# Optional factor-status field; leave blank for the approved presence-based mapping.
AI_WORLD_IAM_FACTOR_STATUS_FIELD=
# IAM authentication-method value that identifies a voice biometric factor.
AI_WORLD_IAM_VOICE_METHOD_VALUE=VOICE_BIOMETRIC
# Required enrolled status when the approved mapping uses a status field.
AI_WORLD_IAM_ENROLLED_STATUS_VALUE=
# Comma-separated statuses treated as not enrolled when a status field is configured.
AI_WORLD_IAM_NOT_ENROLLED_STATUS_VALUES=
# Normalized state used when the response contains no voice factor.
AI_WORLD_IAM_ABSENT_VOICE_STATUS=NOT_ENROLLED
# Enable the user-confirmed deletion action; leave false if deletion is not permitted.
AI_WORLD_IAM_UNENROLLMENT_ENABLED=false
# IAM factor-deletion path; Java substitutes the current userId and factorId.
AI_WORLD_IAM_FACTOR_RESOURCE_PATH=/mfa/v1/users/{userId}/factors/{factorId}
# Factor-response field containing the current voice factor ID.
AI_WORLD_IAM_FACTOR_ID_FIELD=factorId
# Factor-response field used to verify that the factor belongs to the current user.
AI_WORLD_IAM_FACTOR_USER_GUID_FIELD=userGUID

# Read-only PKCS12/JKS file references. Password values live in separate restricted files.
AI_WORLD_IAM_MTLS_KEYSTORE_FILE=
# Customer-owned restricted file containing the keystore password.
AI_WORLD_IAM_MTLS_KEYSTORE_PASSWORD_FILE=
# Format of the customer client-certificate/private-key keystore: PKCS12 or JKS.
AI_WORLD_IAM_MTLS_KEYSTORE_TYPE=PKCS12
# Customer-owned truststore containing trusted IAM server certificate authorities.
AI_WORLD_IAM_MTLS_TRUSTSTORE_FILE=
# Customer-owned restricted file containing the truststore password.
AI_WORLD_IAM_MTLS_TRUSTSTORE_PASSWORD_FILE=
# Format of the customer IAM server-CA truststore: PKCS12 or JKS.
AI_WORLD_IAM_MTLS_TRUSTSTORE_TYPE=PKCS12

# Voice Biometrics SDK
# Enable IAM-authorized ABIS sessions through the Voice Biometrics SDK.
AI_WORLD_ABIS_ENABLED=false
# Stable ABIS WSS origin/base path; IAM supplies the one-time token at runtime.
AI_WORLD_ABIS_BASE_URL=
# Verify ABIS certificate and hostname; false applies only to these test attempts.
AI_WORLD_ABIS_TLS_VERIFY=true
# ABIS connection timeout in milliseconds (1–300000).
AI_WORLD_ABIS_CONNECT_TIMEOUT_MS=10000
# Maximum verification utterance length; short replies have no client minimum.
AI_WORLD_ABIS_VERIFICATION_MAX_MS=10000
# Minimum retained enrollment audio before a sample can be submitted.
AI_WORLD_ABIS_REGISTRATION_MIN_MS=7000
# Maximum retained enrollment audio per sample; ABIS controls sample count.
AI_WORLD_ABIS_REGISTRATION_MAX_MS=10000
# Audio retained before a detected speech onset, in milliseconds.
AI_WORLD_ABIS_PRE_ROLL_MS=200
# Pause that ends an active utterance, in milliseconds.
AI_WORLD_ABIS_END_SILENCE_MS=800
# Consecutive SDK analysis frames required for enrollment speech onset.
AI_WORLD_ABIS_REGISTRATION_START_FRAMES=3
# Maximum queued SDK audio bytes while awaiting ABIS credit.
AI_WORLD_ABIS_PENDING_PCM_BYTES=4194304
# Maximum wait to drain audio and receive provider completion.
AI_WORLD_ABIS_FINISH_TIMEOUT_MS=30000
# Debug only: ask ABIS to retain enrollment audio.
AI_WORLD_ABIS_STORE_ENROLLMENT_AUDIO=false
# Debug only: ask ABIS to retain verification audio.
AI_WORLD_ABIS_STORE_VERIFICATION_AUDIO=false

# Enable OCI Speech transcription alongside the biometric SDK.
AI_WORLD_OCI_SPEECH_ENABLED=false

# Authentication strategy:
# - SESSION_TOKEN for local development. The referenced OCI profile contains tenancy, region,
#   security_token_file, and key_file entries created by `oci session authenticate`.
# - INSTANCE_PRINCIPAL on an OCI compute instance. Config file and profile are then unused; grant
#   the instance's dynamic group permission to use Speech in the target compartment.
AI_WORLD_OCI_AUTH_MODE=SESSION_TOKEN
# OCI configuration file path used by SESSION_TOKEN authentication.
AI_WORLD_OCI_CONFIG_FILE=
# Named OCI session-token profile authorized for Speech.
AI_WORLD_OCI_PROFILE=AI_WORLD_DEMO

# Optional validation guards. When blank, tenancy and region come from the selected OCI
# authentication provider. Expected-tenancy validation is supported for SESSION_TOKEN only.
AI_WORLD_OCI_EXPECTED_TENANCY_OCID=
# Optional expected OCI region; otherwise obtained from the OCI authentication provider.
AI_WORLD_OCI_REGION=

# Required authorization scope in both authentication modes; this is not stored in an OCI profile.
AI_WORLD_OCI_SPEECH_COMPARTMENT_OCID=

# Optional base-URL override. When blank, Java derives the regional Speech WSS origin from the
# authentication provider's region and realm. RealtimeSpeechClient appends /ws/transcribe/stream.
# Example shape: wss://realtime.aiservice.<region>.oci.oraclecloud.com. `ws://` is never valid for
# this downstream setting, even during a local browser HTTP test.
AI_WORLD_OCI_SPEECH_REALTIME_ENDPOINT=

# Default OCI realtime profile. WHISPER accepts GENERIC with `en` or `auto` and emits final
# transcript segments. ORACLE accepts GENERIC or MEDICAL with a locale such as `en-US`.
# The silence/stabilization values below are Oracle-only and are omitted from Whisper requests.
# `WHISPER_LARGE` is not an OCI realtime model value.
AI_WORLD_OCI_SPEECH_MODEL_TYPE=WHISPER
# Speech recognition domain supported by the selected model, such as GENERIC or MEDICAL.
AI_WORLD_OCI_SPEECH_MODEL_DOMAIN=GENERIC
# Language/locale accepted by the selected Speech model.
AI_WORLD_OCI_SPEECH_LANGUAGE_CODE=en
# Speech input encoding; keep audio/raw;rate=16000 for this app PCM stream.
AI_WORLD_OCI_SPEECH_ENCODING='audio/raw;rate=16000'
# Speech punctuation mode, such as AUTO.
AI_WORLD_OCI_SPEECH_PUNCTUATION=AUTO
# Request Speech audio acknowledgements.
AI_WORLD_OCI_SPEECH_ACK_ENABLED=true
# Oracle model partial-result stabilization setting.
AI_WORLD_OCI_SPEECH_STABILIZE_PARTIAL_RESULTS=NONE
# Oracle model pause before a partial-result update, in milliseconds.
AI_WORLD_OCI_SPEECH_PARTIAL_SILENCE_MS=0
# Oracle model pause before finalizing a transcript segment, in milliseconds.
AI_WORLD_OCI_SPEECH_FINAL_SILENCE_MS=300
# Maximum wait for the Speech connection to become ready, in milliseconds.
AI_WORLD_OCI_SPEECH_READINESS_TIMEOUT_MS=10000
# Maximum wait for final transcript responses after Stop, in milliseconds.
AI_WORLD_OCI_SPEECH_DRAIN_TIMEOUT_MS=10000
